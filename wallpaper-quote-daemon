#!/usr/bin/env bash
# Refresh the day's quote wallpaper at each local midnight.
# Launched once at login from the Hyprland autostart, so it inherits the
# Wayland/Hyprland session env needed to relaunch hyprpaper.
set -uo pipefail

# Singleton: never run two copies (e.g. after `hyprctl reload`).
exec 9>"$HOME/.cache/hypr/.quote-daemon.lock" 2>/dev/null || true
flock -n 9 2>/dev/null || exit 0

GEN="$HOME/.local/bin/wallpaper-quote"
CONF="$HOME/.config/hypr/hyprpaper.conf"

while true; do
    now=$(date +%s)
    next=$(date -d 'tomorrow 00:00:05' +%s)   # just after local midnight
    secs=$(( next - now ))
    [ "$secs" -lt 30 ] && secs=30
    sleep "$secs"

    "$GEN" || true                            # render the new day's quote
    pkill -x hyprpaper 2>/dev/null || true     # reload hyprpaper (ipc reload is unreliable)
    for i in $(seq 1 200); do pgrep -x hyprpaper >/dev/null || break; done
    setsid -f hyprpaper -c "$CONF" 2>/dev/null || true
done
