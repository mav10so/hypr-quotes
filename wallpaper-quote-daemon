#!/usr/bin/env bash
# Apply today's quote wallpaper now, then refresh it when the date rolls over.
# On Omarchy this applies via `omarchy-theme-bg-set` (the shell's native
# background IPC); on a plain Hyprland setup (no Omarchy shell) it falls back
# to hyprpaper's IPC reload, or swaybg as a last resort — so the same script
# works either way.
set -uo pipefail

# Singleton: never run two copies (e.g. after `hyprctl reload`).
# The lock lives in ~/.cache/hypr, which a fresh install does not have yet;
# without it the open fails, flock fails, and the daemon quietly exits.
mkdir -p "$HOME/.cache/hypr"
exec 9>"$HOME/.cache/hypr/.quote-daemon.lock" 2>/dev/null || true
flock -n 9 2>/dev/null || exit 0

GEN="$HOME/.local/bin/wallpaper-quote"

# Longest we ever sleep in one go. `sleep` counts *awake* time only — the
# monotonic clock stops while the machine is suspended — so a single long
# sleep aimed at midnight silently slips by the whole suspend duration. A
# laptop closed overnight would therefore keep yesterday's quote on screen
# all morning. Capping the sleep bounds the staleness after a resume to
# this many seconds instead.
MAX_SLEEP=300

set_wallpaper() {
  local img="$1"

  if command -v omarchy-theme-bg-set >/dev/null 2>&1; then
    omarchy-theme-bg-set "$img"
    return
  fi

  if command -v hyprctl >/dev/null 2>&1 && pgrep -x hyprpaper >/dev/null 2>&1; then
    # Plain Hyprland + hyprpaper: reload in place via IPC, no restart needed.
    hyprctl hyprpaper unload all >/dev/null 2>&1 || true
    hyprctl hyprpaper preload "$img" >/dev/null 2>&1 || true
    hyprctl hyprpaper wallpaper ",$img" >/dev/null 2>&1 || true
    return
  fi

  if command -v swaybg >/dev/null 2>&1; then
    pkill -x swaybg 2>/dev/null || true
    setsid swaybg -i "$img" -m fill >/dev/null 2>&1 &
    disown
    return
  fi

  echo "wallpaper-quote-daemon: no supported wallpaper backend found (omarchy-theme-bg-set / hyprpaper / swaybg)" >&2
  return 1
}

APPLIED=""   # date (%F) whose quote is currently on screen

apply() {
  # wallpaper-quote writes a date-stamped file and prints its path; changing
  # that path is what makes Omarchy Shell reload the texture instead of
  # retaining a cached one. Take the date from the name it actually wrote so
  # the two of us can never disagree about which day is on screen.
  local out
  out="$("$GEN")" || return
  [ -n "$out" ] || return

  set_wallpaper "$out" || true

  local day="${out##*/wallpaper-}"
  APPLIED="${day%.jpg}"

  # One 500KB-odd jpg per day would otherwise accumulate forever.
  find "$HOME/.cache/hypr" -maxdepth 1 -name 'wallpaper-????-??-??.jpg' \
    -mtime +2 -delete 2>/dev/null || true
}

apply

while true; do
  now=$(date +%s)
  secs=$(( $(date -d 'tomorrow 00:00:05' +%s) - now ))
  [ "$secs" -gt "$MAX_SLEEP" ] && secs=$MAX_SLEEP
  [ "$secs" -lt 5 ] && secs=5
  sleep "$secs" 9<&-

  # Compare against the date actually on screen rather than assuming the
  # sleep landed where it was aimed. This re-applies after a resume, and
  # after a manual clock or timezone change, without firing twice a day.
  today=$(date +%F)
  [ "$today" != "$APPLIED" ] && apply
done
