#!/usr/bin/env bash
# Compose the day's quote onto the base wallpaper and print the path of the
# image written; wallpaper-quote-daemon puts it on screen.
set -euo pipefail

# --- config (tweak to taste) ---
BASE="/usr/share/omarchy/themes/last-horizon/backgrounds/1-eyes-wide.jpg"
# Use a date-stamped path. Omarchy Shell caches an image by path, so overwriting
# one fixed filename can leave yesterday's texture visible after a refresh.
OUT="$HOME/.cache/hypr/wallpaper-$(date +%F).jpg"
FONT="/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf"
POINTSIZE=34            # text size (on the 2160px-tall base; ~24px on screen)
BOTTOM_OFFSET=40        # pixels up from the bottom edge
TEXT_OPACITY=0.85       # 0.0 - 1.0
# --------------------------------

mkdir -p "$(dirname "$OUT")"

# Same day-of-year pick used by the terminal greeting, so both always agree.
QUOTE="$("$HOME/.local/bin/quote-of-the-day")"

magick "$BASE" \
  -gravity south -font "$FONT" -pointsize "$POINTSIZE" \
  -fill "rgba(0,0,0,0.55)"                 -annotate "+2+$((BOTTOM_OFFSET-2))" "$QUOTE" \
  -fill "rgba(255,255,255,$TEXT_OPACITY)"  -annotate "+0+$BOTTOM_OFFSET"       "$QUOTE" \
  -quality 92 "$OUT"

# Report the file we wrote, so callers never have to re-derive the date
# themselves (and can't disagree with us across a midnight rollover).
echo "$OUT"
