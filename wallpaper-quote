#!/usr/bin/env bash
# Compose the day's quote onto the base wallpaper (replaces Hyprland's built-in splash).
# Output is what hyprpaper displays. Runs at login + at midnight (see autostart / daemon).
set -euo pipefail

# --- config (tweak to taste) ---
BASE="/usr/share/backgrounds/3qwx1v.jpg"
QUOTES="$HOME/.config/hypr/quotes.txt"
OUT="$HOME/.cache/hypr/wallpaper.jpg"
FONT="$HOME/.local/share/fonts/JetBrainsMonoNLNerdFont-Light.ttf"
POINTSIZE=34            # text size (on the 2160px-tall base; ~24px on screen)
BOTTOM_OFFSET=40        # pixels up from the bottom edge
TEXT_OPACITY=0.85       # 0.0 - 1.0
# --------------------------------

mkdir -p "$(dirname "$OUT")"

# Pick TODAY'S quote by day-of-year: stable all day, cycles through the year.
mapfile -t POOL < <(grep -vhE '^\s*(#|$)' "$QUOTES" 2>/dev/null)
N=${#POOL[@]}
if [ "$N" -gt 0 ]; then
  DOY=$((10#$(date +%j)))            # 001..366 -> 1..366
  QUOTE="${POOL[$(( (DOY-1) % N ))]}"
else
  QUOTE="stay hydrated"
fi

magick "$BASE" \
  -gravity south -font "$FONT" -pointsize "$POINTSIZE" \
  -fill "rgba(0,0,0,0.55)"                 -annotate "+2+$((BOTTOM_OFFSET-2))" "$QUOTE" \
  -fill "rgba(255,255,255,$TEXT_OPACITY)"  -annotate "+0+$BOTTOM_OFFSET"       "$QUOTE" \
  -quality 92 "$OUT"
